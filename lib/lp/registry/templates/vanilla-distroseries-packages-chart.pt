<tal:root xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n" omit-tag="">
  <div id="packages-chart" class="packages-chart">
    <tal:tabs tal:replace="structure view/packages_chart_tabs/render" />
    <div tal:attributes="id view/packages_chart_tabs/active_panel_id"
         tal:condition="python:view.packages_chart_tabs.active == 'source'" style="display: flex; justify-content: center; align-items: center; padding-block: var(--dimension-spacing-inline-xxxl)">
        <svg
          width="180"
          height="180"
          chart="donut"
          chart-radius="100"
          chart-title="96,008"
          chart-subtitle="Total"
          chart-clockwise="true"
          chart-min-ratio="0.02"
          chart-thickness="20"
          chart-gap="15"
          chart-segments='[
            {"value": 12, "fill": "#4D4D4D", "label": "12 Failures"},
            {"value": 34, "fill": "#24598F", "label": "34 Builds"},
            {"value": 0, "fill": "#8C8C8C", "label": "0 Unknown"},
            {"value": 56, "fill": "#0E8420", "label": "56 Total"}
          ]'
        >
        </svg>
    </div>
    <div tal:attributes="id view/packages_chart_tabs/active_panel_id"
         tal:condition="python:view.packages_chart_tabs.active == 'binary'">
      <p class="u-text--muted">Package chart binary placeholder</p>
    </div>
  </div>
</tal:root>
