<tal:root xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n" omit-tag="">
  <div id="bugs-list">
    <tal:tabs tal:replace="structure view/bugs_list_tabs/render" />
    <div tal:attributes="id view/bugs_list_tabs/active_panel_id"
         tal:condition="python:view.bugs_list_tabs.active == 'subscriptions'">
      <tal:not-logged-in tal:condition="not: view/user">
        <p class="u-text--muted">
          Please <a href="/+login">log in</a> to see your subscribed bugs.
        </p>
      </tal:not-logged-in>
      <tal:logged-in tal:condition="view/user">
        <tal:table tal:replace="structure view/bugs_subscriptions_markup" />
        <a tal:attributes="href view/bugs_url/subscriptions">View all subscribed bugs</a>
      </tal:logged-in>
    </div>
    <div tal:attributes="id view/bugs_list_tabs/active_panel_id"
         tal:condition="python:view.bugs_list_tabs.active == 'important'">
      <tal:table tal:replace="structure view/bugs_important_markup" />
      <a tal:attributes="href view/bugs_url/critical">View all important bugs</a>
    </div>
    <div tal:attributes="id view/bugs_list_tabs/active_panel_id"
         tal:condition="python:view.bugs_list_tabs.active == 'new'">
      <tal:table tal:replace="structure view/bugs_new_markup" />
      <a tal:attributes="href view/bugs_url/latest">View all new bugs</a>
    </div>
  </div>
</tal:root>
