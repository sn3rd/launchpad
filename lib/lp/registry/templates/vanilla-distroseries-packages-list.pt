<tal:root xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n" omit-tag="">
  <div id="packages-list">
    <tal:tabs tal:replace="structure view/packages_list_tabs/render" />
    <div tal:attributes="id view/packages_list_tabs/active_panel_id"
         tal:condition="python:view.packages_list_tabs.active == 'latest'">
      <tal:table tal:replace="structure view/packages_list_data" />
      <a tal:attributes="href view/packages_url">View all packages</a>
    </div>
    <div tal:attributes="id view/packages_list_tabs/active_panel_id"
         tal:condition="python:view.packages_list_tabs.active == 'my-uploads'">
      <tal:not-logged-in tal:condition="not: view/user">
        <p class="u-text--muted">
          Please <a href="/+login">log in</a> to see your uploads.
        </p>
      </tal:not-logged-in>
      <tal:logged-in tal:condition="view/user">
        <tal:table tal:replace="structure view/my_uploads_data" />
        <a tal:attributes="href view/my_related_packages_url">View all my uploads</a>
      </tal:logged-in>
    </div>
  </div>
</tal:root>
