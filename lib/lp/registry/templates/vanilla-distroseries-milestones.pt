<tal:root xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n" omit-tag="">

  <section class="p-section"
    tal:define="milestones python: list(context.all_milestones[:10])">
    <hr class="p-rule" />
    <h3 class="u-flex--row">
      Milestones
      <a
      tal:attributes="href context/menu:overview/create_milestone/url"
      tal:condition="context/menu:overview/create_milestone/enabled"
      title="Create milestone"
      class="p-button--base is-inline has-icon u-no-margin"
      >
        <i class="p-icon--add"></i>
      </a>
    </h3>
    <div class="table-container" tal:condition="milestones">
      <table>
        <caption class="u-off-screen">Milestones for this series</caption>
        <thead>
          <tr>
            <th scope="col">Version</th>
            <th scope="col">Expected</th>
            <th scope="col">Summary</th>
          </tr>
        </thead>
        <tbody>
          <tr tal:repeat="milestone milestones">
            <td>
              <a class="p-link--soft" tal:attributes="href milestone/fmt:url" tal:content="milestone/name">
                1.0
              </a>
            </td>
            <td tal:content="milestone/dateexpected/fmt:approximatedate">2026-01-01</td>
            <td tal:content="milestone/summary">Summary</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p tal:condition="not: milestones" class="u-text--muted">
      No milestones have been set for this series.
    </p>
    <a tal:attributes="href string:${context/fmt:url}/+milestones">
      All milestones
    </a>
  </section>
</tal:root>
