<tal:root xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n" omit-tag="">
  <section id="translation-coverage" class="p-section"
    tal:define="distroseries_languages python: view.distroserieslanguages">
    <hr class="p-rule" />
    <h3>Translation coverage</h3>
    <table tal:condition="distroseries_languages">
      <caption class="u-off-screen">Translation coverage by language</caption>
      <colgroup>
        <col style="width: 35%;" />
        <col style="width: 30%;" />
        <col style="width: 20%;" />
        <col style="width: 15%;" />
      </colgroup>
      <thead>
        <tr>
          <th scope="col">Language</th>
          <th scope="col">Status</th>
          <th scope="col">Contributors</th>
          <th scope="col" aria-label="Actions"></th>
        </tr>
      </thead>
      <tbody>
        <tr tal:repeat="distroseries_language distroseries_languages">
          <td tal:content="distroseries_language/language/englishname">English</td>
          <td>
            <meter min="0" max="100"
              tal:attributes="value python: '%.1f' % distroseries_language.translatedPercentage();
                              title python: '%.1f%%' % distroseries_language.translatedPercentage()"
              style="--meter-width: 100%; vertical-align: middle; min-width: 100px;">
            </meter>
          </td>
          <td tal:content="distroseries_language/contributor_count">0</td>
          <td>
            <a tal:attributes="href string:${distroseries_language/fmt:url}">Contribute</a>
          </td>
        </tr>
      </tbody>
    </table>
    <p tal:condition="not: distroseries_languages" class="u-text--muted">
      No translations have been submitted for this series.
    </p>
    <a tal:condition="distroseries_languages"
       tal:attributes="href string:${context/fmt:url}/+translations">
      All languages
    </a>
  </section>
</tal:root>
