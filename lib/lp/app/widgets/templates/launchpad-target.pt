<table>
  <tr>
    <td>
      <label>
        <input
            type="radio" value="package"
            tal:replace="structure view/options/package" />
        Distribution
      </label>
    </td>
    <td>
      <tal:distribution tal:replace="structure view/distribution_widget" />
    </td>
  </tr>
  <tr>
    <td align="right">
      <label tal:attributes="for string:${view/name}.option.package">
        Package
      </label>
    </td>
    <td>
      <tal:package tal:replace="structure view/package_widget" />
    </td>
  </tr>

  <tr tal:condition="view/show_ppa_option">
    <td>
      <label>
        <input type="radio" value="ppa"
               tal:replace="structure view/options/ppa" />
        PPA
      </label>
    </td>
    <td>
      <tal:ppa tal:replace="structure view/ppa_widget" />
    </td>
  </tr>
  <tr tal:condition="view/show_ppa_option">
    <td align="right">
      <label tal:attributes="for string:${view/name}.option.ppa">
        Package
      </label>
    </td>
    <td>
      <tal:ppa_package tal:replace="structure view/ppa_package_widget" />
    </td>
  </tr>

  <tr>
    <td>
      <label>
        <input type="radio" value="product"
               tal:replace="structure view/options/product" />
       Project
      </label>
    </td>
    <td>
      <tal:product tal:replace="structure view/product_widget" />
    </td>
  </tr>
</table>
